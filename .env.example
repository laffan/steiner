# Copy this file to `.env.local` and fill in your values.
# `.env.local` is gitignored by Vite by default; never commit real keys.

# Dropbox app key from https://www.dropbox.com/developers/apps
# App settings: Scoped Access → App folder; permissions:
# files.content.read, files.content.write, account_info.read.
#
# Add the redirect URI you intend to use to the Dropbox app's "OAuth 2 →
# Redirect URIs" list. Steiner defaults to the HTTPS bridge below, which
# JS-redirects into the steiner:// custom scheme — necessary because
# Chrome on Android silently drops a server-side 302 straight to a
# custom-scheme URL.
#   - Production:  https://laffan.github.io/steiner/oauth-callback.html
#   - Local dev:   http://localhost:5174/oauth-callback.html
# Override the default by setting VITE_DROPBOX_REDIRECT_URI below.
VITE_DROPBOX_APP_KEY=
# VITE_DROPBOX_REDIRECT_URI=http://localhost:5174/oauth-callback.html
