{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steiner",
  "version": "0.1.0",
  "identifier": "com.steiner.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["steiner"]
      },
      "mobile": [
        { "scheme": ["steiner"] }
      ]
    }
  }
}
