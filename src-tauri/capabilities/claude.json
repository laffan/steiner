{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "claude-remote",
  "description": "Capabilities for the embedded claude.ai webview. Only the pin_snippet command is exposed; everything else (FS, dialogs, etc.) is denied by omission.",
  "windows": ["main"],
  "webviews": ["claude"],
  "remote": {
    "urls": [
      "https://claude.ai/*",
      "https://*.claude.ai/*",
      "https://claude.com/*",
      "https://*.claude.com/*",
      "https://anthropic.com/*",
      "https://*.anthropic.com/*"
    ]
  },
  "permissions": ["core:webview:default", "core:event:default"]
}
